# Copy to .env.local and fill in. Never commit .env.local.
# Every key below is required unless marked OPTIONAL.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Supabase — Project Settings > API Keys (server-only, never expose)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Resend — https://resend.com/api-keys
RESEND_API_KEY=<resend-key>
# Must be an address on your verified Resend domain. Code falls back to a
# fail-loud placeholder (never delivers) when this is unset — never use the
# old onboarding@resend.dev test address outside Resend's own docs.
RESEND_FROM_EMAIL=inquiry@kaizenhrms.com

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site-key>
TURNSTILE_SECRET_KEY=<secret-key>

# Cron — any long random string. Must match the Authorization header
# of the daily scheduler:  Authorization: Bearer <CRON_SECRET>
# Vercel Cron (vercel.json) or https://cron-job.org
#   -> GET /api/cron/process-newsletter
CRON_SECRET=<generate-with-openssl-rand-hex-32>

# OPTIONAL. Force maintenance page for public routes without a DB read.
# Leave unset/false normally; the Admin > Settings toggle still works.
MAINTENANCE_MODE=false
